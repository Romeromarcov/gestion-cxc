# ── Odoo ──────────────────────────────────────────────────────────────────────
ODOO_HOST=tu-subdominio.odoo.com
ODOO_DB=nombre_base_de_datos
ODOO_USER=usuario@empresa.com
ODOO_API_KEY=tu_api_key_de_odoo

# ── Seguridad JWT ─────────────────────────────────────────────────────────────
# Genera una clave segura con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-una-clave-aleatoria-de-minimo-32-caracteres

# Horas de validez del token JWT (default 8)
ACCESS_TOKEN_EXPIRE_HOURS=8

# ── CORS ──────────────────────────────────────────────────────────────────────
# En desarrollo puedes usar * (wildcard). En producción especifica tu dominio:
# ALLOWED_ORIGINS=https://miapp.railway.app,https://app.lubrikca.com
ALLOWED_ORIGINS=*

# ── Base de datos PostgreSQL ──────────────────────────────────────────────────
# Con Docker Compose el valor se sobreescribe automáticamente.
# Para Railway: agrega el plugin PostgreSQL y copia la DATABASE_URL que genera.
DATABASE_URL=postgresql://gestion_user:gestion_pass@localhost:5432/gestion_cxc

# ── Google Sheets (opcional) ──────────────────────────────────────────────────
# Ruta al JSON de credenciales de cuenta de servicio
# GOOGLE_SHEETS_CRED=credentials.json
# ID de la hoja de cálculo (extraído de la URL de Google Sheets)
# GOOGLE_SHEET_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms
